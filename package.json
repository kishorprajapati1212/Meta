{
  "name": "meta-social-analytics-api",
  "version": "4.3.5",
  "description": "Facebook + Instagram + YouTube + LinkedIn + Pinterest + Google Search Console analytics API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node scripts/selftest.js && node scripts/upstreamtest.js",
    "fixtures": "node scripts/make-fixtures.js",
    "dev:all": "node scripts/devall.js",
    "build:ui": "npm run build --prefix Pulse",
    "smoke": "npm run smoke --prefix Pulse",
    "test:api": "node scripts/selftest.js",
    "test:upstream": "node scripts/upstreamtest.js",
    "report": "node scripts/collect-report.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0"
  }
}
