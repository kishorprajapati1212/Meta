{
  "name": "pulse-analytics-dashboard",
  "private": true,
  "version": "2.3.4",
  "type": "module",
  "description": "Cross-platform social & SEO analytics dashboard for the Meta Analytics API (Facebook, Instagram, YouTube, LinkedIn, Pinterest, Google Search Console)",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_PROXY_TARGET=http://localhost:5000 vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke --logLevel warn && node .smoke/smoke.js",
    "smoke:live": "vite build --ssr scripts/livecheck.jsx --outDir .livecheck --logLevel error && node .livecheck/livecheck.js",
    "fixtures:diagnosis": "node scripts/makeDiagnosisFixtures.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
