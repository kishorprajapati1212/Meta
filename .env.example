# === META (Facebook + Instagram) ===
ACCESS_TOKEN=your_facebook_user_access_token
INSTAGRAM_ID=your_instagram_business_account_id
FACEBOOK_PAGE_ID=your_facebook_page_id

# === YOUTUBE ===
# Only yt-analytics.readonly scope required. Add youtube.readonly for channel info.
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === OPTIONAL ===
PORT=5000
FB_API_VERSION=v19.0
# Set to the date your pages were created (prevents empty-data queries)
ACCOUNT_CREATED=2026-07-05
