# ============================================================
#  Meta Social & SEO Analytics API — environment
#  Copy to .env and fill in. Every credential is optional:
#  platforms without credentials report a clear "not_configured"
#  state in /api/health and render a reconnect prompt in the UI.
# ============================================================

# ── META (Facebook + Instagram) ──────────────────────────────
# Long-lived Page access token. A short-lived one expires in ~2h
# and is the usual cause of "Request failed with status code 400".
ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
INSTAGRAM_ID=your_instagram_business_account_id
# Optional — Graph API version and base URL (override only for testing)
FB_API_VERSION=v19.0
FB_API_BASE=https://graph.facebook.com

# ── YOUTUBE (Google credential set #1) ───────────────────────
# Scopes: youtube.readonly + yt-analytics-monetary.readonly
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional overrides
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
YOUTUBE_ANALYTICS_URL=https://youtubeanalytics.googleapis.com/v2/reports
YOUTUBE_DATA_API_URL=https://www.googleapis.com/youtube/v3

# ── GOOGLE SEARCH CONSOLE (Google credential set #2) ─────────
# Keep these separate from the YouTube set.
# Scope: https://www.googleapis.com/auth/webmasters.readonly
GSC_REFRESH_TOKEN=your_gsc_refresh_token
GSC_CLIENT_ID=your_gsc_google_client_id
GSC_CLIENT_SECRET=your_gsc_google_client_secret
GSC_SITE_URL=https://www.your-website.com/
# Optional override
GSC_API_BASE=https://www.googleapis.com/webmasters/v3

# ── ZERNIO (LinkedIn + Pinterest) ────────────────────────────
ZERNIO_API_KEY=sk_your_zernio_api_key
# Optional override — used by the offline self-test to point at a mock
ZERNIO_BASE_URL=https://zernio.com/api

# ── SHARED ───────────────────────────────────────────────────
PORT=5000
# Start date for "since account creation" queries
ACCOUNT_CREATED=2020-01-01
